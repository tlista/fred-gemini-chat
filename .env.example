# FRED + Gemini Assistant Configuration

# Google Gemini API Key (from https://aistudio.google.com/)
GEMINI_API_KEY=

# St. Louis Federal Reserve (FRED) API Key (from https://fred.stlouisfed.org/docs/api/api_key.html)
FRED_API_KEY=

# Server Configuration
HOST=0.0.0.0
PORT=8000

# Default Gemini Model: gemini-2.5-flash, gemini-1.5-flash, gemini-2.5-pro
DEFAULT_GEMINI_MODEL=gemini-2.5-flash
